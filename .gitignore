# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iCloud Drive sync conflict copies ("Footer 2.tsx", "next-env.d 2.ts").
# This project lives under Desktop, which iCloud syncs, so these appear on their
# own. They are stale pre-edit duplicates that nothing imports, and committing
# "next-env.d 2.ts" is what makes tsc report duplicate identifiers.
* [0-9].ts
* [0-9].tsx
* [0-9].d.ts

# Source media kept alongside the project but never served. public/ is what Next
# ships; this is 50MB+ of originals that would live in a public repo forever.
/Media/
